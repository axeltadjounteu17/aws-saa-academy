{
  "name": "aws-saa-academy-v2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "data:build": "python3 scripts/build_data.py",
    "icons:build": "python3 scripts/build_icons.py",
    "vercel:config": "node scripts/build_vercel_config.mjs",
    "validate-data": "python3 scripts/validate_data.py",
    "build": "npm run validate-data && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "node tests/e2e/browser-check.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "security:secrets": "python3 scripts/scan_secrets.py",
    "security:audit": "npm audit --audit-level=moderate",
    "security:sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json",
    "check": "npm run lint && npm run test:unit && npm run security:secrets && npm run security:audit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.109.0",
    "dompurify": "3.4.16",
    "fuse.js": "7.5.0",
    "lucide-react": "1.49.0",
    "marked": "18.0.14",
    "mermaid": "11.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-helmet-async": "3.0.0",
    "react-router-dom": "7.18.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "27.4.0",
    "postcss": "8.5.28",
    "prettier": "3.9.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "workbox-window": "7.4.1"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
